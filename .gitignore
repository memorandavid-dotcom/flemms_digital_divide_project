# --- Data: keep the folder layout, never commit survey microdata ---
data/**
!data/**/
!data/**/.gitkeep

# --- Secrets ---
.env

# --- Airflow runtime files ---
logs/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/

# --- Generated reports: keep only the latest copy of each in Git ---
outputs/validation/*
!outputs/validation/*_latest.json
