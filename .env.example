# Copy this file to .env and change every "change_me" value.
# .env is listed in .gitignore and must never be committed.

# --- Airflow ---
# Docker image built from the Dockerfile in this repo
AIRFLOW_IMAGE_NAME=flemms-airflow:3.3.2
# User id that Airflow runs as inside the containers (50000 is fine on Windows/macOS)
AIRFLOW_UID=50000
# Airflow's own metadata database (separate from the project warehouse)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow
# Login for the Airflow web UI at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me
# Secret used to sign Airflow's internal API tokens (any long random string)
AIRFLOW_JWT_SECRET=change_me_to_a_long_random_string

# --- Project warehouse (PostgreSQL that holds the curated tables) ---
WAREHOUSE_DB=flemms
WAREHOUSE_USER=flemms
WAREHOUSE_PASSWORD=change_me
# Host/port used when running pipeline.py directly on your machine.
# Inside Docker the containers use warehouse-db:5432 instead (set in docker-compose.yml).
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433

# --- External API (Philippine Standard Geographic Code) ---
PSGC_API_BASE_URL=https://psgc.gitlab.io/api
